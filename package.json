{
  "name": "life-archive",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "ignore"
    }
  },
  "scripts": {
    "start": "node server/main.ts",
    "archive": "node --no-warnings server/archive/cli.ts",
    "llm": "node --no-warnings server/llm/cli.ts",
    "check-data": "node server/check-data.ts",
    "guard": "node --no-warnings server/guard/cli.ts",
    "nas-backup": "node --no-warnings server/nas-backup.ts",
    "health": "node --no-warnings modules/health/cli.ts",
    "exercise": "node --no-warnings modules/exercise/cli.ts",
    "journal": "node --no-warnings modules/journal/cli.ts",
    "rituals": "node --no-warnings modules/rituals/cli.ts",
    "extract-wechat": "node --no-warnings modules/friend-map/connectors/wechat-ios/extract.ts",
    "whatsapp-mac-calls": "node --no-warnings modules/friend-map/connectors/whatsapp-db/macCalls.ts",
    "cua-exports": "node --no-warnings modules/friend-map/jobs/cua-exports.ts",
    "mac-imports": "node --no-warnings modules/friend-map/jobs/mac-imports.ts",
    "module": "node --no-warnings server/moduleCommand.ts",
    "map": "node --no-warnings modules/exercise/cli.ts map",
    "testing-data": "node --no-warnings server/fixtures/testing-data.ts",
    "make-fixtures": "node modules/friend-map/fixtures/make-fixtures.ts",
    "docs": "node --no-warnings tools/docs/docs.ts",
    "build:demo": "node --no-warnings tools/demo/build.ts",
    "check-demo": "node --no-warnings tools/demo/check.ts",
    "serve:demo": "node --no-warnings tools/demo/serve.ts",
    "main-preview": "node --no-warnings tools/mainPreview.ts",
    "file-size": "node --no-warnings tools/checks/fileSize.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.5",
    "@effect/platform-node-shared": "4.0.5",
    "@effect/sql-sqlite-node": "4.0.5",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@protomaps/basemaps": "^5.7.2",
    "@vitejs/plugin-react": "^6.1.2",
    "cesium": "^1.147.0",
    "d3": "^7.9.0",
    "d3-scale": "^4.0.2",
    "effect": "4.0.5",
    "maplibre-gl": "^6.16.0",
    "pmtiles": "^4.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sql.js": "^1.15.2",
    "vite": "^8.3.4",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.5",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/d3": "^7.4.3",
    "@types/d3-scale": "^4.0.9",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
